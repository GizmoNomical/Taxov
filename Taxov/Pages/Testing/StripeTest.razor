        {
            <div>
                &nbsp;@Authentication.SubscriptionStatus
                <br>
                Renews On: @Authentication.SubscriptionTimeLeft
                <br><br>    
                <button @onclick="@(async () => await CancelSub())">Cancel Subscription</button>
            </div>
        }
      @if(Authentication.SubscriptionStatus == "ACTIVE (Pending Cancellation)")
        {
            <div>
                &nbsp;@Authentication.SubscriptionStatus
                <br>
