@inherits Data.Navigation

@using Taxov.Pages
@using Taxov.Pages.Calculator
@using Taxov.Pages.Charts

@code
{
    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public string Text2 { get; set; } = "";
    [Parameter] public bool isChart { get; set; } = false;

    [CascadingParameter(Name = "ToolTipState")]
    private int _ToolTips { get; set; } = 0;
}

<head>
    <link rel="stylesheet" href="css/tooltip.css">
    <meta charset="utf-8">    
</head>
    <div class="tooltip-wrapper">
       
        @if(_ToolTips == 1)
        {
            if(isChart)
            {
                <span style="right: -215%; top: 0%; max-width: 28em; max-height: 1.5em; padding: 0px 5px 1px 5px">
               @WebUtility.HtmlDecode(Text)
                </span>
            }   
            if(!isChart)
            {            
                <span>
                   @WebUtility.HtmlDecode(Text)
                </span>
            }
            @ChildContent
        }

        @if(_ToolTips == 0)
        {
            @ChildContent
        }
    </div>