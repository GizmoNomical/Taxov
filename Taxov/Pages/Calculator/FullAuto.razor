@inject Authentication Authentication;
@inject NavigationManager NavigationManager

@code
{
	private async Task CollapseChart(string id)
	{		
		await JSRuntime.InvokeAsync<string>("collapseChart", id);
	}

	protected override async Task OnInitializedAsync()
	{		
		await Authentication.UpdateDatabaseStatus();
		if(!Authentication.DatabaseOnline)
        {
			return;
        }
		else
		{
			await GetUserSettingsRetryWhenFail();
			await Task.Delay(1000);    
			await JSRuntime.InvokeAsync<string>("collapseChart", "Chart-A");    
			await JSRuntime.InvokeAsync<string>("collapseChart", "Chart-B");
			StateHasChanged();
		}			
	}

	protected override async void OnAfterRender(bool firstRender)
	{
		// execute conditionally for loading data, otherwise this will load
		// every time the page refreshes
		if(firstRender)
		{			
			await Authentication.UpdateDatabaseStatus();			
		}
		if(!Authentication.DatabaseOnline)
		{
			//NavigationManager.NavigateTo("/", forceLoad: true);
		}
	}


	public string _AccessLevel;
    public UserModel User;
    public int _ToolTips = 0;

    private int retryCount = 3;
    private readonly TimeSpan retryDelay = TimeSpan.FromSeconds(1);
		  
    public async Task<Boolean> GetUserSettingsRetryWhenFail()
    {
        int currentRetry = 0;

        for (; ; )
        {
            try
            {
				await Authentication.UpdateDatabaseStatus();
                if(!Authentication.DatabaseOnline)
                {
                    currentRetry++;

                    if (currentRetry > this.retryCount)
                    {
                        Console.WriteLine("GetUserSettingsRetryWhenFail - FULL AUTO - Failed Consecutively...");
                        //NavigationManager.NavigateTo("/", forceLoad: true);
                        return false;
                    }
                    return false;
                }   

                if (await GetUSerSettings())
                {
                    return true;
                }
                else
                {
                    Console.WriteLine("GetUserSettingsRetryWhenFail - FULL AUTO - Failed");

                    currentRetry++;

                    if (currentRetry > this.retryCount)
                    {
                        Console.WriteLine("GetUserSettingsRetryWhenFail - FULL AUTO - Failed Consecutively...");
                        return false;
                    }
                }
            }
            catch (Exception e)
            {
                Console.WriteLine("GetUserSettingsRetryWhenFail - FULL AUTO - Failed");

                currentRetry++;

                if (currentRetry > this.retryCount)
                {
                    Console.WriteLine("GetUserSettingsRetryWhenFail - FULL AUTO - Failed Consecutively...");
                    return false;
                }
            }
            await Task.Delay(retryDelay);
        }
        return true;
    }

    public async Task<Boolean> GetUSerSettings()
    {
			if(!Authentication.DatabaseOnline)
                {
                    return false;
                }

            User = await Authentication.GetUserSettingsFromDB();

            if(User == null)
            {
                return false;    
            }
            else
            {
                _ToolTips = User.ToolTips;

                if(_ToolTips == null)
                {
                    _ToolTips = 0;
                    return false;
                }
                return true;
            }
    }

    public async Task ToggleTipsOn()
    {
        _ToolTips = 1;
		StateHasChanged();
    }

     public async Task ToggleTipsOff()
    {
        if(User == null)
		{
            StateHasChanged();
			return;
		}

        if(User.ToolTips == 1)
        {
            StateHasChanged();
            return;
        }
        _ToolTips = 0;
        StateHasChanged();
    }


}


