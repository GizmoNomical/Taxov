	<div class="content" >	
		<div class="scrollchart">
			<CascadingValue Value="@(VendorGraphValue)">
				<VendorChart></VendorChart>
			</CascadingValue>
		</div>
	</div>
	
<!-- Chart Break-->
	
	<button class="collapsible" id="Chart-B" @onclick="@(() => CollapseChart("Chart-B"))">MARKET MARK UP / DOWN</button>
	<div class="content">	
		<div class="scrollchart">
				<CascadingValue Value="@MarketGraphValue">
					<CascadingValue Value="@MarketGraphLossGain">
					<MarketChart></MarketChart>
					</CascadingValue>
				</CascadingValue>
			</div>
	
</div>

<!-- Chart Break-->			
						
</div>
