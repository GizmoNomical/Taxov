			<span class="rubble" style="color:rgba(180,177,171,1.00);">&#x20bd;</span>  
		  }
		  @if(!BulkSale || ItemQuantity == 1)
		  {
			  <span class="rubble" style="color: #525759;">&#x20bd;</span>
		  }		
		  
		  
		  </td>
      <td>
		  @if(BulkSale && ItemQuantity > 1)
		  {
			  <input class="data" id="netgains" type="number" placeholder="000000" disabled style="color:rgba(180,177,171,1.00);" @bind="_PerItemProfit_OverVendor">
		  }
		  @if(!BulkSale || ItemQuantity == 1)
		  {
			  <input class="data" id="netgains" type="number" placeholder="000000" disabled style="color:#525759;" @bind="_PerItemProfit_OverVendor">
		  }		
		  
		  </td>
    </tr>
	  
	<tr>
      <td class="infotable" style="width: 140px">
				  <ToolTip Text=@ToolTipData.PerItemProfitGross()>
					<div @onclick=@ToggleTipsOn @onmouseout=@ToggleTipsOff>ITEM - TAX</div>
				  </ToolTip>
		  </td>
      <td style="width: 17px">
		  @if(BulkSale && ItemQuantity > 1)
		  {
			<span class="rubble" style="color:rgba(180,177,171,1.00);">&#x20bd;</span>  
		  }
		  @if(!BulkSale || ItemQuantity == 1)
		  {
			  <span class="rubble" style="color: #525759;">&#x20bd;</span>
		  }	
		  
		  </td>
      <td>
		  @if(BulkSale && ItemQuantity > 1)
		  {
			  <input class="data" id="gross" type="number" placeholder="000000" disabled style="color: rgba(180,177,171,1.00);" @bind="_PerItemProfit_Gross">
		  }
		  @if(!BulkSale || ItemQuantity == 1)
		  {
			  <input class="data" id="gross" type="number" placeholder="000000" disabled style="color: #525759;" @bind="_PerItemProfit_Gross">
		  }		
		  
		  </td>
    </tr>
	  
	  <tr>
      <td class="infotable" style="width: 140px">
				  <ToolTip Text=@ToolTipData.PerItemProfitRealized()>
					<div @onclick=@ToggleTipsOn @onmouseout=@ToggleTipsOff>REALIZED</div>
				  </ToolTip>
		  </td>
      <td style="width: 17px">
		  @if(BulkSale && ItemQuantity > 1)
		  {
			<span class="rubble">&#x20bd;</span>  
		  }
		  @if(!BulkSale || ItemQuantity == 1)
		  {
			  <span class="rubble" style="color: #525759;">&#x20bd;</span>
		  }			
		  
		  </td>
      <td>
		  @if(BulkSale && ItemQuantity > 1)
		  {
			   @if(_RealizedGains < VendorBuyBack)
			  {
				<input class="data" id="net" type="number" placeholder="000000" disabled style="color:#FF0004;" @bind="_PerItemProfit_Realized">  
			  }
			  @if(_RealizedGains > VendorBuyBack)
			  {
				  <input class="data" id="net" type="number" placeholder="000000" disabled style="color:#00FF10;" @bind="_PerItemProfit_Realized">
			  }
			  @if(_RealizedGains == VendorBuyBack)
			  {
				  <input class="data" id="net" type="number" placeholder="000000" disabled style="color:#00BDFF;" @bind="_PerItemProfit_Realized">
			  }

		  }
		  @if(!BulkSale || ItemQuantity == 1)
		  {
			  <input class="data" id="net" type="number" placeholder="000000" disabled style="color: #525759;" @bind="_PerItemProfit_Realized">
		  }				  
		  
		  </td>
    </tr>
	  
  </tbody>
</table>

		
		</td>
    </tr>
  </tbody>
</table>

	
	<br>
	</div>
	</div>
		
	
		<div class="charts" align="center">
