                            <img src="/img/cards/bf_access.png" width="128" height="128"/>       
                }
                @if(AccessLevel == "Influencer")
                {
                            <img src="/img/cards/vip_access.png" width="128" height="128"/>     
                }
                @if(AccessLevel == "GameMaster")
                {
                            <img src="/img/cards/vip_access.png" width="128" height="128"/>    
                }
            }
            
            </div>

<br>
<div class="blurthing" style="width:730px; padding: 4px">

    <table width="730" border="0" cellspacing="0" cellpadding="0">
    <tbody>
        <tr>
                   <td style="width: 500px">   
                       <div class="sub-headers" style="text-align:center;">ACCOUNT</div>
                	<table width="500px" border="0" cellspacing="0" cellpadding="0">
                  <tbody>
                      @*<tr class="row-border">
                                <td>
                                    Access Level:
                	           	</td>
                                <td>
                                    @AccessLevel
                                    </td>
                                
                     </tr>*@
                      @*<tr class="row-border">
                              <td style="width:150px">
                                  ClientID:
                              </td>

                              <td style="width:350px">

                                  @if(ClientID == -1)
                                  {
                                      <div>...</div>
                                  }
                                  else
                                  {
                                      @ClientID
                                  }                                  
                                  </td>                             
                     </tr>*@

                
                    <tr class="row-border">
