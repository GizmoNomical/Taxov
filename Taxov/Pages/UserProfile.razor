@*page "/userprofile"*@

@using Auth0.ManagementApi
@using System.Net
@using Newtonsoft.Json.Linq
@using Taxov.Pages
@using Taxov.Pages.Calculator
@using Taxov.Pages.Charts
@using Newtonsoft
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Taxov.Data
@using DataLibrary
@using Microsoft.Extensions.Configuration
@using Stripe;
@using global::Stripe
@using global::Stripe.Checkout

@inject IJSRuntime jsRuntime;
@inject Authentication Authentication;
@inject TokenManager tokenManager;

@code
{
    [CascadingParameter] private Task<AuthenticationState> authenticationStateTask { get; set; }

    [Parameter]
    public string AccessLevel { get; set; }

    [Parameter]
    public int ClientID { get; set; }

    [Parameter]
    public string UserName { get; set; }

    [Parameter]
    public string Email { get; set; }

    [Parameter]
    public int PaidStatus { get; set; }

    [Parameter]
    public string SubTierName { get; set; }

    private UserModel CurrentUser { get; set; }

    private Subscription Subscription { get; set; }

    private bool _loadingPage = true;

    private bool? verified;
    private string isVerified;



    private async Task CheckoutHandler(string priceId)
    {
        string CustomerID = await Authentication.GetCustomerIDFromDB();
        string UserEmail = await Authentication.GetUserEmailFromDB();

        string sessionId = await Authentication.CreateCheckoutSessionAsync(priceId, CustomerID);
        await jsRuntime.InvokeVoidAsync("redirectToCheckout", sessionId);
    }

    private async Task UpdateProfile()
    {   
        if(!ServerStatusManager.ServerOnline)
        {
            StateHasChanged();
            return;
        }

        Authentication.UpdateDatabaseStatus();

        if(!Authentication.DatabaseOnline)
        {
            return;
        }

        //await ClearProfileView();

		if(await Authentication.GetLoggedInUser())
		{
			if(await Authentication.GetAuth0UserID())
			{	
                if(tokenManager.MgmtToken != null)
                {                    
                    if(await Authentication.GetAuth0DataRetryWhenFail())
				    {		
                        Console.WriteLine("Checking User in Database - USERPROFILE");
					    if(await Authentication.CheckUserInDatabase())
                        {   

                            CurrentUser = await Authentication.GetUserProfileDataFromDB();
                            await SetProfileViewData();
                            _loadingPage = false;
                            StateHasChanged(); 
					    }
					    else
					    {
						    if(await Authentication.UserSetup())
						    {
                                CurrentUser = await Authentication.GetUserProfileDataFromDB();
                                await SetProfileViewData();
                                _loadingPage = false;
							    StateHasChanged(); 
						    }
					    }					
				    }
                }
			}     
		}
    }

    private async Task ClearProfileView()
    {        
        string cleared = "...";

        AccessLevel = cleared;
        StateHasChanged();
        ClientID = -1;
        UserName = cleared;
        Email = cleared;
        PaidStatus = -1;
        SubTierName = cleared;
        verified = null;
        await Task.Delay(500);

        StateHasChanged();      
    }

    private async Task SetProfileViewData()
    {        
        _loadingPage = true;
        await ClearProfileView();       

        AccessLevel = CurrentUser.AccessLevel;
        ClientID = CurrentUser.ClientID;
        UserName = CurrentUser.UserName;
        Email = CurrentUser.Email;
        PaidStatus = CurrentUser.PaidStatus;
        SubTierName = CurrentUser.SubTierName;
        CheckEmail();
        try
        {
            await Authentication.GetSubStatusFromStripe();
        }
        catch
        {
            
        }        
        try
        {
            Subscription = await Authentication.GetSubscriptionByID(await Authentication.GetSubscriptionIDFromDB());
            await Authentication.GetSubscriptionPeriod(Subscription);    
        }
        catch
        {
            
        }        
        StateHasChanged();
    }

    public async Task ToggleToolTips(bool _isActive)
    {
        if(!ServerStatusManager.ServerOnline)
        {
            StateHasChanged();
            return;
        }

        Authentication.UpdateDatabaseStatus();

        if(!Authentication.DatabaseOnline)
        {
            StateHasChanged();
            return;
        }
        else
        {
            await Authentication.ToggleToolTipsInDB(_isActive);
            await Authentication.GetUserSettingsFromDB();
            StateHasChanged();
        }
    }

    public async Task ToggleNewsletter(bool _isActive)
    {
        if(!ServerStatusManager.ServerOnline)
        {
            StateHasChanged();
            return;
        }

        Authentication.UpdateDatabaseStatus();

        if(!Authentication.DatabaseOnline)
        {
            StateHasChanged();
            return;
        }
        else
        {            
        await Authentication.ToggleNewsletterInDB(_isActive);
        await Authentication.GetUserSettingsFromDB();
        StateHasChanged();
        }

    }

    public async Task CheckEmail()
    {
        verified = await Authentication.EmailVerificationCheck();
        if(verified == null)
        {
            isVerified = null;   
        }
        if(verified == false)
        {
            isVerified = "\uFFFD";   
        }
        if(verified == true)
        {
            isVerified = "\u2714";
        }
        Console.WriteLine(verified);
    }



    public async Task CancelSub()
    {
        if(!ServerStatusManager.ServerOnline)
        {
            StateHasChanged();
            return;
        }

        Authentication.UpdateDatabaseStatus();

        if(!Authentication.DatabaseOnline)
        {
            StateHasChanged();
            return;
        }
        else
        {
            await Authentication.CancelSubscriptionAtPeriodEnd(Authentication.Subscription.FirstOrDefault().Id);
            StateHasChanged();    
        }

        
    }

    public async Task ReActivateSub()
    {
        if(!ServerStatusManager.ServerOnline)
        {
            StateHasChanged();
            return;
        }

        Authentication.UpdateDatabaseStatus();

        if(!Authentication.DatabaseOnline)
        {
            StateHasChanged();
            return;
        }
        else
        {
            await Authentication.ReActivateCancelledSubscription(Authentication.Subscription.FirstOrDefault().Id);
            StateHasChanged();    
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if(!ServerStatusManager.ServerOnline)
        {
            StateHasChanged();
            return;
        }
        
        Authentication.UpdateDatabaseStatus();

        if(!Authentication.DatabaseOnline)
        {
            StateHasChanged();
            return;
        }
        else
        {
            await ClearProfileView();
            await UpdateProfile();
        }

    }

}


<!doctype html>
<html>

<AuthorizeView>
<body>    
<div class="blurthing2">
    <h1 class="pageh1">USER PROFILE</h1>
    <div style="position:relative; float:right; z-index: 25; top:-38px; padding-right:10px;font-size:12px; width:120px">
        <div style="position:relative; float:left;">Not updating?<br>&nbsp;&nbsp;&nbsp;Click here!</div><div><button class="button" style="background-color:transparent; font-size:30px; float:right" @onclick="@(async () => await UpdateProfile())">&#x21ba;</button></div>
        </div>

            <br><br>
