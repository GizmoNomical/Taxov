                         </tbody>
                    </table>

                    <br>

                   <table width="500px" border="0" cellspacing="0" cellpadding="0">
                  <tbody>
                       
                      </tbody>
                      </table>

	             </td>

                 <!--Right Column-->
                 
                 <td width="230px" style="text-align:center;padding:0px 4px; vertical-align: top;">
                          <div class="sub-headers" style="height: 20px">&#9881;&nbsp;SETTINGS</div>
                     <table width="230" cellpadding="0" cellspacing="0" border="0" style="text-align: center;">
                         <tbody>
                    <tr class="row-border">
                        <td style="text-align:left;">
                            TOOL TIPS
                        </td>
                    </tr>
                    <tr class="row-border">
                        <td>
                            
                                @if(Authentication.CurrentUser != null && Authentication.CurrentUser.ToolTips == 0)
                                {   
