                                          {
                                             <span style="color:green; cursor: default;" title="E-mail Verified">@isVerified</span><span style="font-size:12px"> Verified</span> 
                                          }
                                     @if(verified == false)
                                          {
                                             <span style="color:orange; position:relative; top:-2; cursor: pointer;" title="E-mail Verification Pending">@isVerified</span><span style="font-size:12px"> Unverified</span>
                                          } 
                                          </div>
                                    }              
                                  </td>
                     </tr>
                     <tr>
                                <td style="width:125px;">
                                   Mailing List:                                                 
                		        </td>
                                <td>
                                    @if(Authentication.CurrentUser != null && Authentication.CurrentUser.Newsletter == 0)
                                    {
                                     <input type="checkbox" @onclick="@(async () => await ToggleNewsletter(true))"><span style="font-size:12px">Opt In</span>
                                    }
                                    @if(Authentication.CurrentUser != null && Authentication.CurrentUser.Newsletter == 1)
                                    {
                                     <input type="checkbox" @onclick="@(async () => await ToggleNewsletter(false))" checked><span style="font-size:12px">Opt Out</span>
                                    }
                                </td>
                               
                      </tr>



                     </tbody>
                     </table>
                     <br>
                   <div class="sub-headers" style="text-align:center;">
                      SUBSCRIPTION

                       @if (Authentication.CurrentUser != null && Authentication.SubscriptionStatus != null && Authentication.CurrentUser.AccessLevel != "Influencer" && Authentication.CurrentUser.AccessLevel != "GameMaster")
                        {
                            @if (Authentication.SubscriptionStatus == "ACTIVE")
                            {
                                <button style="float:right; position:fixed; right:250px; font-weight:bolder; border-radius: 4px; border: -4px solid black;" @onclick="@(async () => await CancelSub())">Cancel &#8856;</button>
                            }
