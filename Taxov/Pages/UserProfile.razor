                         </td>
                     </tr>
                     <tr class="row-border">
                                @if (Authentication.CurrentUser != null && Authentication.SubscriptionStatus != null && Authentication.CurrentUser.AccessLevel != "Influencer" && Authentication.CurrentUser.AccessLevel != "GameMaster")
                                {
