		<a href="#" style="font-size:26px; pointer-events: none">
		   &#9776;
		   </a>
	   	   </div>
    <ul> <!--Drop Down Menu-->
      
      <li class="dir"><a href="#" @onclick="@(async () => await HomePage())">TAX TOOL</a>
      </li>
      <li><a href="#" @onclick="@(async () => await ContactPage())">CONTACT</a></li>
