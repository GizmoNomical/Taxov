		<!--RSS -->
		<div style="width:686px; height: 48px;">
			
				@if(ServerStatusManager.ServerOnline)
				{
					<div style="vertical-align: middle" class="RSSBox">
					
						<div id="RSSElementA" style="color: rgba(180,177,171,1.00);">
							
							@((MarkupString)serverStatusManager.RSSElementA)
							
						</div>

						<div id="RSSElementB">
							@((MarkupString)serverStatusManager.RSSElementB)
						</div>
					
					</div>
				}
				@if(!ServerStatusManager.ServerOnline)
				{
					<div style="vertical-align: middle; outline: solid -2px; outline-color: #ff4f00;" class="RSSBox">
					
								<div id="RSSElementA" style="color: rgba(180,177,171,1.00);">
									@((MarkupString)serverStatusManager.RSSElementA)
								</div>

								<div id="RSSElementB">
									@((MarkupString)serverStatusManager.RSSElementB)
								</div>
					</div>
				}					
		</div>

	</div>

		@*Server Offline Header*@
		@if(!ServerStatusManager.ServerOnline)
		{
			<ServerOffline></ServerOffline>

			if(_component != null)
			{
				<DynamicComponent Type=@_component></DynamicComponent>
			}			
		}

		@if(ServerStatusManager.ServerOnline)
		{
			if(_component != null)
			{
				<DynamicComponent Type=@_component></DynamicComponent>
			}			
		}
           
