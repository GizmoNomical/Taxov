	public async Task RefreshPage()
	{
		StateHasChanged();
	}

	public async void RefreshPageTimer(object sender, EventArgs e)
    {
		InvokeAsync(this.RefreshPage);		
		JSRuntime.InvokeVoidAsync("RSSResetOpacity");		
		JSRuntime.InvokeVoidAsync("RSSFadeout");

        InvokeAsync(this.RefreshPage);		
    }

    void IDisposable.Dispose()
    {
        // stop listening
        serverStatusManager.ServerPolled -= RefreshPageTimer;
    }

	protected override async Task OnInitializedAsync()
	{	
		serverStatusManager.ServerPolled += RefreshPageTimer;

		if(!ServerStatusManager.ServerOnline)
		{
			return;
		}
	}

