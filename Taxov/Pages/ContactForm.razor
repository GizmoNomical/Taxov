@*@page "/contactform"*@

@using Taxov.Pages
@using Taxov.Pages.Calculator
@using Taxov.Pages.Charts


<!doctype html>
<html>
<head>
	<style>
.FeedbackForm {
  width: 340px;
  height: 440px;
  background: rgba(22,22,20,.5);
  backdrop-filter:blur(2px);
  outline: solid 1px #525759;
  box-shadow: 0 0 40px -10px #000;
  padding: 20px 30px;
  position: relative;
}
.ContactformH2 {
  margin: 10px 0;
  padding-bottom: 10px;
  width: 180px;
  color: #FFFFFF;
  border-bottom: 3px solid #525759;
}
.feedbackForm input {
  width: 100%;
  padding: 10px;
  box-sizing: border-box;
  background: none;
  outline: none;
  resize: none;
  border: 0;
  transition: all 0.3s;
  border-bottom: 2px solid #525759;
color: #FFFFFF;	
}
input:focus {
  border-bottom: 2px solid rgba(79,76,70,1);
}
.formText:before {
  content: attr(type);
  display: block;
  margin: 28px 0 0;
  font-size: 14px;
  color: #5a5a5a;
}


.sendIt {
    content: "Hi";
    position: absolute;
    background: rgba(20,23,24,1);
    outline: solid 1px #525759;
    font-size: 18px;
    left: 130px;
    top: 447px;
    color: #FFFFFF;
    text-align: center;
    width: 266px;
    height: 29px;
    vertical-align: middle;
}
.essay {
	max-height: 110px;
	max-width: 340px;
	height:110px;
	width: 340px;
	color:#FFFFff;
	background-color: transparent;
	
}
    </style>
	
<meta charset="utf-8">
<title>Untitled Document</title>
<link href="style.css" rel="stylesheet" type="text/css">
</head>

<body>
	
<form class="FeedbackForm" action="mailto:accountant@taxov.tax" method="POST" enctype="multipart/form-data" name="EmailForm">
  <h2 class="ContactformH2">CONTACT US</h2>
  <p class="formText" type="Name:"><input placeholder="Write your name here.."></p>
  <p class="formText" type="Email:"><input  type="email" placeholder="Let us know how to contact you back.."></p>
  <p class="formText" type="Message:"><textarea class="essay" placeholder="What would you like to tell us.."></textarea></p>
  <button type="submit" class="button" >Send Message</button>
  <div class="sendIt">   
    &#128231; accountant@taxov.tax
  </div>
</form>
	
</body>
</html>
