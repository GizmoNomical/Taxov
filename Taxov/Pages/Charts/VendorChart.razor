      <td class ="chartcolor" ><input class="data" type="number" placeholder="000000" disabled @bind="@VendorGraphValue[20]"></td>
    </tr>
	 <tr align="right">
		 <th scope="row"><ToolTip Text=@ToolTipData.VendorChart_BaseValueGains() isChart=true><div @onclick=@ToggleTipsOn @onmouseout=@ToggleTipsOff>&nbsp;&nbsp;GAIN</div></ToolTip></th>
