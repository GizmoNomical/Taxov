@using System.Net
@using Newtonsoft.Json.Linq
@using RestSharp
@using Newtonsoft
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

@using Microsoft.Extensions.Configuration

@implements IDisposable

@inject IDataAccess _data;
@inject IConfiguration _config;
@inject Authentication Authentication;
@inject TokenManager tokenManager;
@inject ServerStatusManager serverStatusManager;

@code
{
    private string UserName { get; set; }

    private int ClientID { get; set; }
    private string AccessLevel { get; set; }

    private string UserNameString = "Loading...";
    private string ClientIDString = "Loading...";

    private int retryCount = 20;
    private int currentRetry = 0;
    private readonly TimeSpan retryDelay = TimeSpan.FromSeconds(0.5);


    [Parameter] public EventCallback OnOpenProfile { get; set;}  
    
    [Parameter] public EventCallback OnClickAccessCard { get; set; }



    protected async Task ProfileLinkClicked()
    {
        if(!ServerStatusManager.ServerOnline)
        {
            await RefreshPage();
            return;
        }

        await UpdateCurrentUser();
        await OnOpenProfile.InvokeAsync();
    }

    protected async Task AccessCardClicked()
    {
        if(!ServerStatusManager.ServerOnline)
        {
            await RefreshPage();
            return;
        }

        await UpdateCurrentUser();
        await OnClickAccessCard.InvokeAsync();
    }


    private async Task UpdateCurrentUser()
    {
        if(!ServerStatusManager.ServerOnline)
        {
            AccessLevel = "...";
            await RefreshPage();
            return;
        }

        await Authentication.GetUserProfileDataFromDB();
        if(Authentication.CurrentUser == null)
        {
            return;            
        }
        else
        {
            AccessLevel = Authentication.CurrentUser.AccessLevel;            
            StateHasChanged();
        }
    }

    public async Task RefreshPage()
    {
        StateHasChanged();
    }

    public async Task<Boolean> ForceDisplayUpdate()
    {
        if(Authentication.Auth0Client == null || Authentication.Auth0Client.UserName == null)
        {
            Console.WriteLine("ForceDisplayUpdate FAILED - Not Authenticated");
            return false;
        }
        else
        {            
            if (Authentication.CreateUserProfileData())
            {
                if (await Authentication.GetLoggedInUser())
                {
                    if (await Authentication.GetAuth0UserID())
                    {                                                
                            if (await Authentication.GetAuth0DataRetryWhenFail())
                        {
                            //Console.WriteLine("GetUserProfileFromDB - ForceDisplayUpdate - LoginDisplay");
                            await Authentication.GetUserProfileDataFromDB();

                                    ClientID = Authentication.CurrentUser.ClientID;
                                    UserName = Authentication.CurrentUser.UserName;
                                    AccessLevel = Authentication.CurrentUser.AccessLevel;

                                    await RefreshPage();
                                    return true;          
                            }
                    }
                    Console.WriteLine("ForceDisplayUpdate FAILED");
                    return false;
                }
                Console.WriteLine("ForceDisplayUpdate FAILED");
                return false;
            }
            else
            {
                Console.WriteLine("ForceDisplayUpdate FAILED");
                return false;
            }
        }
    }

    public async Task<Boolean> RefreshDisplayRetryWhenFail()
    {
        int currentRetry = 0;

        for (; ; )
        {
            try
            {  
                if (await ForceDisplayUpdate())
                {                    
                    Console.WriteLine("LoginDisplay Forced Update Success!");
                    return true;
                }
                else
                {
                    Console.WriteLine("RefreshDisplayRetryWhenFail - LOGINDISPLAY - Failed");

                    currentRetry++;

                    if (currentRetry > this.retryCount)
                    {
                        return false;
                    }
                }
            }
            catch (Exception e)
            {
                Console.WriteLine("RefreshDisplayRetryWhenFail - LOGINDISPLAY - Failed Consecutively");

                currentRetry++;

                if (currentRetry > this.retryCount)
                {             
                    return false;
                }
            }
            await Task.Delay(retryDelay);
        }
        return true;
    }

    public async void RefreshPageTimer(object sender, EventArgs e)
    {
        //Console.WriteLine("Refresh Timer Updated Page");
        if(ServerStatusManager.ServerOnline)
        {
            if(Authentication.authState.User.Identity.IsAuthenticated)
            {                
                if(UserNameString == "Loading..." || ClientIDString == "Loading...")
                InvokeAsync(ForceDisplayUpdate);
            }
        }
        InvokeAsync(RefreshPage);        
    }

    void IDisposable.Dispose()
    {
        // stop listening
        serverStatusManager.ServerPolled -= RefreshPageTimer;
    }

    protected override async Task OnInitializedAsync()
    {
        serverStatusManager.ServerPolled += RefreshPageTimer;        
    }

    protected override async void OnAfterRender(bool firstRender)
	{
		if(!ServerStatusManager.ServerOnline)
		{
			firstRender = true;
		}

		// execute conditionally for loading data, otherwise this will load
		// every time the page refreshes
		if(firstRender)
		{			
			if(ServerStatusManager.ServerOnline)
			{
				if(Authentication.authState.User.Identity.IsAuthenticated)
				{			
					if (UserName == null)
                    {
                        Console.WriteLine("Refresh Display - Page Load - LOGINDISPLAY");
                        await RefreshDisplayRetryWhenFail();
                    }  
				}
				else
				{
					Console.WriteLine("User Not Authenticated - LOGINDISPLAY...");
					return;
				}
			}			
		}
	}

}



